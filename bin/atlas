#!/usr/bin/env bash
# The atlas plugin's command line. Plain bash while every command is a path lookup;
# commands that need more move behind this shim to a bun CLI, the way awt's do.
#
# An atlas repo's awt.config.mjs calls `atlas schema path <version>` to find the entry
# schema, so the plugin's install location is never written into a repo.
set -euo pipefail

# Reachable as ~/.local/bin/atlas: resolve the symlink chain to find the plugin root.
# `readlink -f` is GNU-only, so walk it.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  if [[ "$target" == /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SCHEMAS="$ROOT/schemas"

usage() {
  cat <<'EOF'
atlas: the atlas plugin's command line

Usage
  atlas schema path <version> [name]   absolute path of a schema this plugin ships; name defaults to entry
  atlas schema list                    the schema versions this plugin ships, one per line
  atlas --version                      the plugin version and the commit it was installed from
  atlas --help                         this

Exit codes: 0 ok, 1 no such schema, 2 bad usage.
EOF
}

die() {
  printf 'atlas: %s\n' "$1" >&2
  exit "${2:-1}"
}

schema_list() {
  local dir
  for dir in "$SCHEMAS"/*/; do
    [[ -d "$dir" ]] && basename "$dir"
  done
  return 0
}

schema_path() {
  local version="$1" name="${2:-entry}"
  # Both end up in a path, so neither may carry a separator or `..`.
  # Kubernetes-style: v1 is frozen once published; v1alpha1 and v1beta1 may still change in place.
  [[ "$version" =~ ^v[0-9]+((alpha|beta)[0-9]+)?$ ]] || die "version must look like v1, v1alpha1 or v1beta1, got: $version" 2
  [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "schema name must be lowercase kebab-case, got: $name" 2

  local file="$SCHEMAS/$version/$name.schema.json"
  if [[ ! -f "$file" ]]; then
    die "no $name schema in $version; this plugin ships: $(schema_list | tr '\n' ' ')" 1
  fi
  printf '%s\n' "$file"
}

# `atlas 0.0.0 (<commit>)`. The version is plugin.json's, which stays 0.0.0 for a
# snapshot; the commit is what scripts/install recorded, so a checkout says so instead.
version() {
  local manifest version stamp
  manifest="$(<"$ROOT/.claude-plugin/plugin.json")"
  [[ "$manifest" =~ \"version\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]] || die "no version in $ROOT/.claude-plugin/plugin.json" 1
  version="${BASH_REMATCH[1]}"
  if [[ -f "$ROOT/INSTALLED_FROM" ]]; then stamp="$(<"$ROOT/INSTALLED_FROM")"; else stamp="working copy"; fi
  printf 'atlas %s (%s)\n' "$version" "$stamp"
}

case "${1:-}" in
  schema)
    shift
    case "${1:-}" in
      path)
        shift
        [[ $# -ge 1 && $# -le 2 ]] || die "usage: atlas schema path <version> [name]" 2
        schema_path "$@"
        ;;
      list)
        shift
        [[ $# -eq 0 ]] || die "usage: atlas schema list" 2
        schema_list
        ;;
      -h | --help) usage ;;
      "") usage >&2; exit 2 ;;
      *) die "unknown schema command: $1 (see atlas --help)" 2 ;;
    esac
    ;;
  -h | --help) usage ;;
  --version) version ;;
  "") usage >&2; exit 2 ;;
  *) die "unknown command: $1 (see atlas --help)" 2 ;;
esac
